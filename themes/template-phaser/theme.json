{
  "schemaVersion": 1,
  "name": "Aurora Core",
  "author": "Clawd",
  "version": "1.1.0",
  "description": "Sandbox Phaser pet — aurora core, orbital rings, ribbon trail, state-reactive bloom (clawd-pet.v1).",

  "renderBackend": "sandbox",
  "sandbox": {
    "entry": "index.html",
    "engine": "phaser",
    "network": false
  },

  "customization": {
    "petTint": false
  },

  "viewBox": {
    "x": 0,
    "y": 0,
    "width": 256,
    "height": 256
  },

  "layout": {
    "contentBox": { "x": 48, "y": 32, "width": 160, "height": 192 },
    "centerX": 128,
    "baselineY": 224,
    "visibleHeightRatio": 0.75,
    "baselineBottomRatio": 0.05
  },

  "hitBoxes": {
    "default": { "x": 48, "y": 32, "w": 160, "h": 192 },
    "sleeping": { "x": 48, "y": 32, "w": 160, "h": 192 },
    "wide": { "x": 48, "y": 32, "w": 160, "h": 192 }
  },

  "eyeTracking": {
    "enabled": false,
    "states": []
  },

  "states": {
    "idle": ["_sandbox"],
    "thinking": ["_sandbox"],
    "working": ["_sandbox"],
    "juggling": ["_sandbox"],
    "error": { "fallbackTo": "attention" },
    "attention": ["_sandbox"],
    "notification": ["_sandbox"],
    "sleeping": { "fallbackTo": "idle" },
    "waking": ["_sandbox"]
  },

  "sleepSequence": {
    "mode": "direct"
  },

  "reactions": {
    "click": { "file": "_sandbox", "duration": 400 },
    "drag": { "file": "_sandbox" }
  }
}
