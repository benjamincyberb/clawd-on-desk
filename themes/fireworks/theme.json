{
  "schemaVersion": 1,
  "name": "祈年殿爆破",
  "author": "Clawd",
  "version": "11.0.0",
  "description": "B-tier illustration 祈年殿 (triple blue glaze eaves, cylinder hall, marble terraces) — idle look first; click demolishes.",

  "renderBackend": "sandbox",
  "sandbox": {
    "entry": "index.html",
    "engine": "phaser",
    "network": false
  },

  "customization": {
    "petTint": false
  },

  "viewBox": {
    "x": 0,
    "y": 0,
    "width": 320,
    "height": 480
  },

  "layout": {
    "contentBox": { "x": 16, "y": 16, "width": 288, "height": 448 },
    "centerX": 160,
    "baselineY": 450,
    "visibleHeightRatio": 0.92,
    "baselineBottomRatio": 0.05
  },

  "hitBoxes": {
    "default": { "x": 16, "y": 16, "w": 288, "h": 448 },
    "sleeping": { "x": 16, "y": 16, "w": 288, "h": 448 },
    "wide": { "x": 16, "y": 16, "w": 288, "h": 448 }
  },

  "eyeTracking": {
    "enabled": false,
    "states": []
  },

  "states": {
    "idle": ["_sandbox"],
    "thinking": ["_sandbox"],
    "working": ["_sandbox"],
    "juggling": ["_sandbox"],
    "error": { "fallbackTo": "attention" },
    "attention": ["_sandbox"],
    "notification": ["_sandbox"],
    "sleeping": { "fallbackTo": "idle" },
    "waking": ["_sandbox"]
  },

  "sleepSequence": {
    "mode": "direct"
  },

  "reactions": {
    "click": { "file": "_sandbox", "duration": 0 },
    "drag": { "file": "_sandbox" }
  }
}
